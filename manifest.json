{
  "manifest_version": 3,
  "name": "NeutralEye - Bias Checker",
  "version": "1.1.4",
  "description": "Shows how a news article frames its story: tone, sourcing, and omission. See multiple perspectives before you finish reading.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}